# Uploads to App Store Connect with fastlane (APPSTORE.md, "Upload with fastlane"), with the App
# Store Connect API key that CI also signs with, from the same three environment variables as the
# GitHub secrets: APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID and
# APP_STORE_CONNECT_API_KEY_BASE64 (`base64 -i AuthKey_XXXX.p8`).
#   bundle exec fastlane ios upload ipa:trimix-blender-1.2.3.ipa   # the app, to TestFlight
#   bundle exec fastlane ios metadata                              # listings, release notes, screenshots
# CI runs both on a release's tag (ci-cd.yml, job "iOS app"). Neither submits for review: select the
# build and submit in App Store Connect.
# Actions run from the repository's root (fastlane's rule), Ruby code here from fastlane/.
require 'fileutils'
require 'json'
require 'tmpdir'

skip_docs # no generated fastlane/README.md

ROOT = File.expand_path('..', __dir__)

# The version being released: package.json's, set by `npm version` (the IPA has the same).
def app_version
  JSON.parse(File.read(File.join(ROOT, 'package.json'))).fetch('version')
end

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'),
    issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
    key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_BASE64'),
    is_key_content_base64: true
  )
end

platform :ios do
  desc 'Uploads a signed IPA to App Store Connect: in TestFlight after processing'
  lane :upload do |options|
    ipa = options[:ipa] || UI.user_error!('ipa: the signed .ipa to upload')
    upload_to_testflight(
      api_key: api_key,
      ipa: File.expand_path(ipa, ROOT),
      # The "What to Test" notes need the processed build: not waited for (minutes of a macOS
      # runner). The release notes go with the listing (metadata).
      skip_waiting_for_build_processing: true
    )
  end

  desc "Uploads the version's listing in every language: texts and release notes " \
       '(fastlane/metadata/ios, npm run listings) and screenshots (fastlane/screenshots/ios)'
  lane :metadata do
    key = api_key
    metadata = File.join(ROOT, 'fastlane/metadata/ios')
    # App Store Connect refuses release notes ("What's New") on an app's first version: without a
    # version on the store yet, the listing goes without them.
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    app || UI.user_error!('The app is not in App Store Connect: create it first (APPSTORE.md)')
    if app.get_live_app_store_version.nil?
      UI.message('First version: no release notes')
      first = Dir.mktmpdir
      FileUtils.cp_r("#{metadata}/.", first)
      FileUtils.rm(Dir.glob("#{first}/*/release_notes.txt"))
      metadata = first
    end
    deliver(
      api_key: key,
      app_version: app_version, # created in App Store Connect if it is not there yet
      metadata_path: metadata,
      screenshots_path: 'fastlane/screenshots/ios',
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: false,
      submit_for_review: false,
      # No HTML preview to confirm; precheck cannot check in-app purchases with an API key (none).
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
